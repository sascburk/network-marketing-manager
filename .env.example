# ============================================================
#  Burkard CRM  -  Umgebungsvariablen
#  Kopiere diese Datei zu ".env" und fuelle die Werte aus.
#  Die .env wird NICHT ins Git committed (siehe .gitignore).
# ============================================================

# ---------- Datenbank (PostgreSQL) ----------
# Diese Werte werden vom "db"-Service aus docker-compose.yml benutzt.
POSTGRES_USER=burkard
POSTGRES_PASSWORD=bitte_sicheres_passwort_setzen
POSTGRES_DB=burkard_crm

# Verbindungs-URL der App zur Datenbank.
# Im Docker-Compose-Netz ist der Host der Servicename "db".
DATABASE_URL=postgresql://burkard:bitte_sicheres_passwort_setzen@db:5432/burkard_crm

# ---------- Sessions / Sicherheit ----------
# Zufaelliges, langes Geheimnis fuer Session-Signatur.
# Erzeugen z.B. mit:  openssl rand -base64 48
SESSION_SECRET=bitte_mit_openssl_rand_base64_48_erzeugen

# ---------- Web Push (VAPID) ----------
# Erzeugen mit:  npm run gen-vapid   (gibt beide Schluessel aus)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Kontakt fuer Push-Dienste (mailto: oder https://)
VAPID_SUBJECT=mailto:admin@burkard3.ch

# ---------- App ----------
# Oeffentliche Basis-URL (hinter dem Reverse-Proxy). Fuer absolute Links.
APP_URL=https://burkard3.ch
# Port, auf dem die App INNERHALB des Containers lauscht.
PORT=3000
NODE_ENV=production

# ---------- Erster Admin (nur beim ersten Start / create-admin) ----------
# Wird vom Script scripts/create-admin.mjs genutzt, falls gesetzt.
ADMIN_EMAIL=sascha@burkard3.ch
ADMIN_PASSWORD=bitte_aendern
ADMIN_NAME=Sascha Burkard

# ---------- Reminder-/Push-Scheduler ----------
# Interner Intervall-Job sendet faellige Follow-up- & Geburtstags-Pushes.
# true = eingebauter Scheduler im App-Container aktiv.
ENABLE_SCHEDULER=true
# Intervall in Minuten, in dem auf faellige Erinnerungen geprueft wird.
SCHEDULER_INTERVAL_MINUTES=15
